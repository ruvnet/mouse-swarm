{
  "name": "@ruvector/mouse-swarm",
  "version": "0.1.0",
  "description": "Sequential landing page reveals with simulated mouse swarms and installable Claude Code and Codex skills.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./ruflo": {
      "types": "./src/ruflo.d.ts",
      "default": "./src/ruflo.js"
    },
    "./ruflo-view": {
      "types": "./src/ruflo-view.d.ts",
      "default": "./src/ruflo-view.js"
    },
    "./ruflo-cli": {
      "types": "./src/ruflo-cli.d.ts",
      "default": "./src/ruflo-cli.js"
    },
    "./activity": {
      "types": "./src/activity.d.ts",
      "default": "./src/activity.js"
    },
    "./metaharness": {
      "types": "./src/metaharness.d.ts",
      "default": "./src/metaharness.js"
    },
    "./video": {
      "types": "./src/video.d.ts",
      "default": "./src/video.js"
    },
    "./metaharness-file": {
      "types": "./src/metaharness-file.d.ts",
      "default": "./src/metaharness-file.js"
    },
    "./playwright": {
      "types": "./src/playwright.d.ts",
      "default": "./src/playwright.js"
    }
  },
  "bin": {
    "mouse-swarm": "bin/mouse-swarm.js",
    "mouse-swarm-video": "bin/video.js",
    "mouse-swarm-activity-video": "bin/activity-video.js"
  },
  "files": [
    "src",
    "bin",
    "skills",
    "examples",
    "assets",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "prepack": "node --check src/index.js && node --check src/ruflo.js && node --check src/ruflo-view.js && node --check src/ruflo-cli.js && node --check src/ruflo-server.js && node --check bin/mouse-swarm.js && node --check src/activity.js && node --check src/metaharness.js && node --check src/video.js && node --check bin/video.js && node --check bin/activity-video.js && node --check examples/activity-replay.js && node --check src/metaharness-file.js && node --check src/playwright.js && node --check examples/playwright-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/mouse-swarm.git"
  },
  "homepage": "https://github.com/ruvnet/mouse-swarm#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mouse",
    "swarm",
    "animation",
    "reveal",
    "codex",
    "claude",
    "skill"
  ],
  "types": "./src/index.d.ts"
}
